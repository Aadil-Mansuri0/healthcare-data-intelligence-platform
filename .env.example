# ═══════════════════════════════════════════════════════════════════════════
# Healthcare Data Platform — Environment Variables
# Copy this file to .env and fill in real values. NEVER commit the real .env
# ═══════════════════════════════════════════════════════════════════════════

# ─── Source PostgreSQL ────────────────────────────────────────────────────
POSTGRES_HOST=postgres-source.rds.amazonaws.com
POSTGRES_DB=healthcare_cms
POSTGRES_USER=pipeline_user
POSTGRES_PASSWORD=change_me

# ─── AWS (S3 Data Lake) ───────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=ap-south-1
S3_BUCKET=healthcare-datalake

# ─── Snowflake ─────────────────────────────────────────────────────────────
SNOWFLAKE_ACCOUNT=xy12345.ap-south-1
SNOWFLAKE_USER=healthcare_svc
SNOWFLAKE_PASSWORD=change_me
SNOWFLAKE_WAREHOUSE=HEALTHCARE_WH
SNOWFLAKE_DATABASE=HEALTHCARE_DW
SNOWFLAKE_SCHEMA=GOLD_SCHEMA
SNOWFLAKE_ROLE=HEALTHCARE_READER

# ─── OpenAI (NL2SQL + AI Assistant) ───────────────────────────────────────
OPENAI_API_KEY=sk-change_me

# ─── Airflow ───────────────────────────────────────────────────────────────
AIRFLOW_SECRET_KEY=generate_a_random_secret_key

# ─── Frontend ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── Docker Hub (CI/CD) ────────────────────────────────────────────────────
DOCKERHUB_USERNAME=your_dockerhub_username
DOCKERHUB_TOKEN=your_dockerhub_token
