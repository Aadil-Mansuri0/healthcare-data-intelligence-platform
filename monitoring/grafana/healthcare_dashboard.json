{
  "title": "Healthcare Data Platform — API Monitoring",
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Request Rate (per endpoint)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(rate(http_requests_total[5m])) by (endpoint)" }
      ]
    },
    {
      "id": 2,
      "title": "p95 Request Latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, endpoint))" }
      ]
    },
    {
      "id": 3,
      "title": "5xx Error Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "sum(rate(http_errors_total[5m])) by (endpoint)" }
      ]
    },
    {
      "id": 4,
      "title": "AI Query Volume (success vs rejected vs failed)",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "sum(ai_queries_total) by (status)" }
      ]
    },
    {
      "id": 5,
      "title": "Snowflake Query Latency (p50/p95/p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(snowflake_query_duration_seconds_bucket[5m]))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, rate(snowflake_query_duration_seconds_bucket[5m]))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, rate(snowflake_query_duration_seconds_bucket[5m]))", "legendFormat": "p99" }
      ]
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
